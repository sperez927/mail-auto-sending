{
  "manifest_version": 3,
  "name": "Invite Mail Sender",
  "version": "2.0.0",
  "description": "Send one personal invitation email per row of a CSV/Excel list from your Gmail (via the Gmail API), with random templates and random delays.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "action": {
    "default_title": "Open Invite Mail Sender"
  }
}
